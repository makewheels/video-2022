# video-2022 环境变量配置
# 复制此文件为 .env 并填入实际值
# .env 文件不会被提交到 Git

# ========== 阿里云 OSS (视频存储) ==========
ALIYUN_OSS_VIDEO_ACCESS_KEY_ID=
ALIYUN_OSS_VIDEO_SECRET_KEY=

# ========== 阿里云 OSS (数据存储) ==========
ALIYUN_OSS_DATA_ACCESS_KEY_ID=
ALIYUN_OSS_DATA_SECRET_KEY=

# ========== 阿里云 MPS (视频转码) ==========
ALIYUN_MPS_ACCESS_KEY_ID=
ALIYUN_MPS_SECRET_KEY=

# ========== 阿里云 API 网关 (IP查询) ==========
ALIYUN_APIGATEWAY_IP_APPCODE=

# ========== 以下仅生产环境需要 ==========
# MongoDB 凭证
MONGODB_USERNAME=
MONGODB_PASSWORD=
# Redis 密码
REDIS_PASSWORD=
# SSL 证书密码
SSL_KEYSTORE_PASSWORD=

# ========== 自建点播转码（Infisical prod 注入） ==========
TRANSCODE_PIPELINE=legacy
ALIYUN_CF_TRANSCODE_CPU_URL=
ALIYUN_CF_TRANSCODE_GPU_URL=
ALIYUN_CF_TRANSCODE_INVOKE_SECRET=
ALIYUN_CF_TRANSCODE_CALLBACK_SECRET=
ALIYUN_MPS_FALLBACK_TEMPLATE_720P=
ALIYUN_MPS_FALLBACK_TEMPLATE_1080P=
TRANSCODE_DEADLINE_BASE_SECONDS=180
TRANSCODE_DEADLINE_DURATION_MULTIPLIER=4
TRANSCODE_MAX_DIRECT_BITRATE_BPS=13000000
TRANSCODE_RETRY_BACKOFF_MS=10000
TRANSCODE_RETRY_JITTER_MS=3000
TRANSCODE_RECOVERY_ENABLED=true
TRANSCODE_FALLBACK_MPS_ENABLED=true

# 仅函数部署流水线读取，不注入后端容器。
TRANSCODE_CPU_MAX_CONCURRENCY=2
TRANSCODE_GPU_MAX_CONCURRENCY=2
TRANSCODE_CALLBACK_HOST=oneclick.video
FC_DEPLOY_AK_ID=
FC_DEPLOY_AK_SECRET=
CALLBACK_SECRET=
